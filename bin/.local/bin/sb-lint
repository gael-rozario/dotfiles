#!/usr/bin/env bash
# sb-lint — validate second-brain notes against the vault's OKF conventions.
# Usage: sb-lint [file...]        (default: every concept note in the vault)
# Vault: $SB_VAULT (default: ~/gbrain/second-brain)
# Exits non-zero if any ERROR is found (WARNs don't fail the run).
set -uo pipefail

VAULT="${SB_VAULT:-$HOME/gbrain/second-brain}"
[[ -d $VAULT ]] || { echo "sb-lint: vault not found: $VAULT" >&2; exit 1; }

errors=0 warns=0

report() { # report <level> <file> <msg>
  printf '%s: [%s] %s\n' "${2#"$VAULT"/}" "$1" "$3"
  [[ $1 == ERROR ]] && errors=$((errors+1)) || warns=$((warns+1))
}

field() {
  awk -v k="$2" '/^---$/{c++; next} c==1 && $0 ~ "^"k": "{sub("^"k": ",""); print; exit} c>1{exit}' "$1"
}

declare -a TYPE_LIST=()
declare -A TYPE_DESC=()

# load_types — read the note-type vocabulary (type + kind-of-content columns)
# from the table under this vault's own index.md '## Ingestion workflow …'
# heading. Never hardcode it: the taxonomy evolves, and different vaults
# (second-brain vs third-brain) use different ones. Types carry no
# destination — where a note is filed decides its PARA category.
load_types() {
  local idx="$VAULT/index.md" found=0 line c
  local -a header=() cells=() trimmed=()
  [[ -f $idx ]] || { echo "${0##*/}: $idx not found" >&2; exit 1; }
  local type_idx=-1 desc_idx=-1 i
  while IFS= read -r line; do
    if [[ $found -eq 0 ]]; then
      shopt -s nocasematch
      [[ $line =~ ^#{1,6}[[:space:]]*Ingestion[[:space:]]+workflow ]] && found=1
      shopt -u nocasematch
      continue
    fi
    [[ $line =~ ^#+ ]] && break
    [[ $line =~ ^\|(.+)\|[[:space:]]*$ ]] || continue
    IFS='|' read -ra cells <<<"${BASH_REMATCH[1]}"
    trimmed=()
    local all_sep=1
    for c in "${cells[@]}"; do
      c="${c#"${c%%[![:space:]]*}"}"; c="${c%"${c##*[![:space:]]}"}"; c="${c//\`/}"
      trimmed+=("$c")
      [[ $c =~ ^:?-{2,}:?$ ]] || all_sep=0
    done
    [[ $all_sep -eq 1 ]] && continue
    if [[ ${#header[@]} -eq 0 ]]; then
      for i in "${!trimmed[@]}"; do
        header+=("${trimmed[$i],,}")
        [[ ${trimmed[$i],,} == type ]] && type_idx=$i || { [[ $desc_idx -lt 0 ]] && desc_idx=$i; }
      done
      continue
    fi
    [[ $type_idx -ge 0 && -n ${trimmed[$type_idx]} ]] || continue
    TYPE_LIST+=("${trimmed[$type_idx]}")
    [[ $desc_idx -ge 0 ]] && TYPE_DESC["${trimmed[$type_idx]}"]="${trimmed[$desc_idx]}"
  done < "$idx"
  [[ ${#TYPE_LIST[@]} -gt 0 ]] || { echo "${0##*/}: no note types found in $idx" >&2; exit 1; }
  for c in "${TYPE_LIST[@]}"; do TYPE_DESC["$c"]="${TYPE_DESC[$c]:-}"; done
}
load_types

lint_file() {
  local f=$1 base rel
  base=$(basename "$f"); rel=${f#"$VAULT"/}

  # frontmatter block present
  if [[ $(head -1 "$f") != --- ]] || ! awk '/^---$/{c++} END{exit c<2}' "$f"; then
    report ERROR "$f" "missing or unterminated YAML frontmatter block"
    return
  fi

  local type desc ts
  type=$(field "$f" type); desc=$(field "$f" description)

  # title is the filename and the PARA category is the top-level folder —
  # neither is stored in frontmatter. Inbox captures may leave type unset;
  # sb-review asks for it at filing time.
  if [[ -z $type ]]; then
    if [[ $rel == 0_inbox/* ]]; then
      report WARN "$f" "no 'type' yet — sb-review will ask for it when filing"
    else
      report ERROR "$f" "empty or missing 'type' (OKF conformance)"
    fi
  elif [[ -z ${TYPE_DESC[$type]+set} ]]; then
    report WARN "$f" "unknown type '$type' (not in index.md's note types)"
  fi
  [[ -n $desc ]]  || report ERROR "$f" "missing 'description'"
  local stale
  for stale in category title; do
    [[ -n $(field "$f" $stale) ]] && report WARN "$f" "'$stale:' is no longer stored in frontmatter — remove it"
  done

  # date: is the old convention
  grep -q '^date:' <(awk '/^---$/{c++; next} c==1' "$f") \
    && report ERROR "$f" "uses 'date:' — use timestamp: 'YYYY-MM-DDTHH:MM:SSZ'"

  # timestamp format (required except Hub stubs — it's the note's only date)
  ts=$(field "$f" timestamp)
  if [[ -z $ts ]]; then
    [[ $type != Hub ]] && report ERROR "$f" "missing 'timestamp'"
  elif ! [[ $ts =~ ^\'?[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\'?$ ]]; then
    report ERROR "$f" "malformed timestamp: $ts"
  fi

  # hubs: each entry quoted '[[...]]' and resolving to a hub file; the only
  # inline form allowed is the empty list
  local hubs_inline
  hubs_inline=$(field "$f" hubs)
  [[ -z $hubs_inline || $hubs_inline == '[]' ]] \
    || report ERROR "$f" "hubs must be a '- '[[name]]'' list or [] — got: $hubs_inline"
  while IFS= read -r hubline; do
    if [[ ! $hubline =~ ^-\ \'\[\[.+\]\]\'$ ]]; then
      report ERROR "$f" "hub entry not in quoted '[[...]]' form: $hubline"
    else
      local hub=${hubline#*\[\[}; hub=${hub%%\]\]*}
      [[ -f $VAULT/3_resources/hubs/$hub.md ]] \
        || report ERROR "$f" "hub '[[${hub}]]' has no file in 3_resources/hubs/"
    fi
  done < <(awk '/^---$/{c++; next} c==1 && inhubs && /^[a-zA-Z_]+:/{inhubs=0}
               c==1 && inhubs && /^ *-/{sub(/^ +/,""); print}
               c==1 && /^hubs:/{inhubs=1} c>1{exit}' "$f")

  # legacy tags: key should be migrated to hubs:
  grep -q '^tags:$' <(awk '/^---$/{c++; next} c==1' "$f") \
    && report ERROR "$f" "uses 'tags:' — migrated convention is 'hubs:'"

  # filename convention: the date lives in timestamp:, so filed notes are
  # bare-named; DailyLog notes are named by their date (YYYY-MM-DD.md).
  # Inbox notes may still carry okf-mcp's date prefix; sb-review strips it.
  if [[ $type == DailyLog ]]; then
    [[ $base =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\.md$ ]] \
      || report WARN "$f" "DailyLog filename should be YYYY-MM-DD.md"
  elif [[ $rel != 0_inbox/* && $base =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}_(.+)$ ]]; then
    report WARN "$f" "filename has a date prefix — rename to '${BASH_REMATCH[1]}' (date lives in timestamp)"
  fi

  # body: Obsidian wikilinks (skipping fenced code blocks — bash [[ ]] is not a link)
  awk '/^---$/{c++; next} c<2{next} /^ *```/{fence=!fence; next} !fence' "$f" | grep -qF '[[' \
    && report WARN "$f" "body contains [[wikilinks]] — use markdown links with paths"
  while IFS= read -r target; do
    local decoded=${target//\%20/ }
    [[ -e $VAULT$decoded ]] || report WARN "$f" "link target not found: $target"
  done < <(awk '/^---$/{c++; next} c>=2' "$f" | grep -o '](/[^)]*)' | sed 's/^](//; s/)$//')

  # unprocessed status shouldn't survive filing
  if [[ $rel != 0_inbox/* ]] && [[ $(field "$f" status) == unprocessed ]]; then
    report WARN "$f" "status: unprocessed but note is filed outside 0_inbox"
  fi
}

if [[ $# -ge 1 ]]; then
  files=("$@")
else
  mapfile -t files < <(find "$VAULT/0_inbox" "$VAULT/1_projects" "$VAULT/2_areas" "$VAULT/3_resources" "$VAULT/4_archive" \
    -type f -name '*.md' ! -name index.md ! -name log.md 2>/dev/null | sort)
fi

for f in "${files[@]}"; do lint_file "$f"; done

echo "sb-lint: ${#files[@]} files checked, $errors error(s), $warns warning(s)"
[[ $errors -eq 0 ]]
